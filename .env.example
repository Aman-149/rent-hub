# PORT: The port the Express server listens on.
PORT=5000

# JWT_SECRET: Secret key used to sign and verify authentication tokens.
JWT_SECRET=your_jwt_secret_here

# FRONTEND_URL: The URL of the frontend app, used for CORS configuration.
FRONTEND_URL=http://localhost:5173

# DATABASE_URL: Optional. PostgreSQL connection string. If not provided,
# the app falls back to the embedded JSON file database (server/data/db.json).
DATABASE_URL=

# ADMIN_EMAIL / ADMIN_PASSWORD: Optional. If both are set, an admin account
# is created automatically the first time the server starts (no-op once it
# exists). Leave unset and use `npm run create-admin` instead if you prefer
# not to keep admin credentials in .env.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# ADMIN_NAME: Optional display name for the bootstrapped admin account.
ADMIN_NAME=
